# Settings for the Major's Lair engagement bot and admin website.
# Fill in the values after the = signs. No quotes. Lines starting with # are comments.
# Step-by-step instructions for every value: docs/HETZNER_GUIDE.md (Part 1).

# --- Website address ------------------------------------------------------
# The domain name that points at this server, without https:// (example: lair.duckdns.org).
# The admin website will be https://<this value>. HTTPS certificates are automatic.
DOMAIN=

# --- Discord ----------------------------------------------------------------
# Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=
# Right-click your server icon > Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=
# Developer Portal > your application > OAuth2 > Client ID
DISCORD_CLIENT_ID=
# Developer Portal > your application > OAuth2 > Client Secret (Reset Secret)
DISCORD_CLIENT_SECRET=
# Optional: private channel ID that receives a copy of every audit event.
DISCORD_AUDIT_CHANNEL_ID=
# Optional: comma-separated role IDs allowed to use admin commands and the website.
# The server owner and anyone with the Administrator permission are always allowed.
ADMIN_ROLE_IDS=

# --- twitterapi.io (read-only API access is all this bot uses) ----------------
TWITTERAPI_IO_KEY=

# --- Database ---------------------------------------------------------------
# Password for the bot's own PostgreSQL container. The installer fills this in
# automatically. Do not change it after the first start.
POSTGRES_PASSWORD=

# INFO is fine. Use DEBUG only when investigating a problem.
LOG_LEVEL=INFO

# --- Advanced (leave empty on the Hetzner setup) ------------------------------
# Public address if it is not https://DOMAIN, e.g. http://localhost:8000 for local development.
APP_BASE_URL=
# OAuth callback if it is not APP_BASE_URL/auth/callback.
DISCORD_OAUTH_REDIRECT_URI=
# Comma-separated host names allowed to reach the site. Defaults to DOMAIN plus localhost.
TRUSTED_HOSTS=
# Full database URL for local development (the Hetzner setup sets this automatically).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/majors_lair
ADMIN_SESSION_TTL_HOURS=12
RUN_DISCORD_BOT=true
