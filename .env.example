# Discord
DISCORD_TOKEN=
# Optional: guild-scoped command sync is almost immediate. Omit for global commands.
DISCORD_GUILD_ID=
# Optional: private Discord channel that mirrors AuditLog events.
DISCORD_AUDIT_CHANNEL_ID=
# Optional comma-separated role IDs allowed to run admin commands.
# Server administrators are always allowed.
ADMIN_ROLE_IDS=

# twitterapi.io (read-only API access is all this bot uses)
TWITTERAPI_IO_KEY=

# Google Sheets
GOOGLE_SHEET_ID=
# Use either a credentials file path or inline service-account JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

LOG_LEVEL=INFO
