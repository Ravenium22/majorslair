# Required Discord bot / guild configuration
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# Optional Discord operations
DISCORD_AUDIT_CHANNEL_ID=
# Comma-separated Discord role IDs. Guild owner and Administrator permission also work.
ADMIN_ROLE_IDS=

# Required read-only X data provider
TWITTERAPI_IO_KEY=

# Required PostgreSQL connection. Railway uses a reference to its Postgres service.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/majors_lair

# Public admin site origin, without a trailing slash
APP_BASE_URL=http://localhost:8000
# Production: your exact Railway domain plus localhost values if desired
TRUSTED_HOSTS=localhost,127.0.0.1

# Runtime controls
ADMIN_SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
RUN_DISCORD_BOT=true
PORT=8000
LOG_LEVEL=INFO
